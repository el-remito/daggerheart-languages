div class="dh-languages-dialog">

  {{!-- Point pool (PC only) --}}
  {{#if isPC}}
  <div class="point-bar">
    <span class="point-label">
      {{localize "DHLANG.Dialog.points"}}
      <span class="point-formula-info" data-tooltip="{{pointFormula}}">ⓘ</span>
    </span>
    <div class="point-track">
      <div class="point-fill {{#if pool.overspent}}overspent{{/if}}" style="width: {{pool.percent}}%"></div>
    </div>
    <span class="point-values">{{pool.spent}} / {{pool.total}}</span>
  </div>
  {{#if pool.hasRules}}
  <details class="pool-breakdown">
    <summary class="pool-breakdown-toggle">{{localize "DHLANG.Dialog.poolBreakdownToggle"}}</summary>
    <ul class="pool-breakdown-list">
      {{#each pool.breakdownLines}}
      <li class="pool-breakdown-item {{#if this.negative}}is-negative{{/if}}">
        <span class="pool-breakdown-label">{{this.label}}</span>
        <span class="pool-breakdown-value">{{this.sign}}{{this.value}}</span>
      </li>
      {{/each}}
    </ul>
  </details>
  {{/if}}
  {{/if}}

  {{!-- Adversary note --}}
  {{#if isAdversary}}
  <p class="adversary-note">{{localize "DHLANG.Dialog.adversaryFreeNote"}}</p>
  {{/if}}

  {{!-- Search bar --}}
  <div class="dh-lang-search-bar">
    <input type="search" class="dh-lang-search" placeholder="{{localize 'DHLANG.Search.placeholder'}}" />
  </div>

  {{!-- Acquired languages --}}
  {{#if acquiredLanguages.length}}
  <div class="acquired-section">
    <div class="acquired-section-header">
      <h3>{{localize "DHLANG.Dialog.acquired"}}</h3>
      <button type="button" data-action="shareLanguages" data-tooltip="{{localize 'DHLANG.Dialog.shareTooltip'}}">📢</button>
    </div>
    {{#each acquiredLanguages}}
    <div class="acquired-row">
      <span class="lang-name">{{this.name}}</span>
      {{#if ../isGM}}
      <button
        type="button"
        data-action="removeLanguage"
        data-language-id="{{this.id}}"
        class="remove-btn"
      >{{localize "DHLANG.Dialog.remove"}}</button>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- Active discounts (PC only) --}}
  {{#if activeDiscounts.length}}
  <details class="active-discounts">
    <summary class="active-discounts-toggle">
      <em>{{localize "DHLANG.Dialog.activeDiscountsToggle"}}</em>
    </summary>
    <ul class="active-discounts-list">
      {{#each activeDiscounts}}
      <li class="active-discount-item {{#if this.alreadyAcquired}}is-acquired{{/if}} {{#if this.hasMultiple}}has-multiple{{/if}}">
        <span class="discount-lang">
          {{this.languageName}}
          <span class="discount-category">({{this.categoryName}})</span>
        </span>
        {{#if this.hasMultiple}}
        <span class="discount-best-of">{{localize "DHLANG.Dialog.activeDiscountsBestOf"}}</span>
        <ul class="discount-options">
          {{#each this.discounts}}
          <li class="discount-option">
            <span class="discount-info">−{{this.discountAmount}} pts · {{this.requirementText}}</span>
          </li>
          {{/each}}
        </ul>
        {{else}}
        <span class="discount-info">−{{this.discounts.[0].discountAmount}} pts · {{this.discounts.[0].requirementText}}</span>
        {{/if}}
      </li>
      {{/each}}
    </ul>
  </details>
  {{/if}}

  {{!-- Available languages by category --}}
  {{#each categories}}
  <details class="lang-category" data-category-id="{{this.id}}">
    <summary class="lang-category-name">
      <span class="lang-category-title">{{this.name}}</span>
      <span class="category-count">({{this.acquiredCount}} / {{this.totalCount}})</span>
      {{#if this.description}}<p class="lang-category-description">{{this.description}}</p>{{/if}}
    </summary>
    {{#each this.languages}}
    <div class="lang-row {{#unless this.canAfford}}unaffordable{{/unless}} {{#unless this.requirementMet}}unmet-requirement{{/unless}}">
      <span class="lang-name">{{this.name}}</span>
      {{#if this.description}}<p class="lang-description">{{this.description}}</p>{{/if}}
      <div class="lang-actions">
        {{#unless ../../isAdversary}}
          {{#if this.infoTooltip}}
            <span class="lang-info{{#if this.alreadyAcquired}} is-acquired{{/if}}" data-tooltip="{{this.infoTooltip}}">ⓘ</span>
          {{/if}}
          <span class="lang-cost{{#if this.alreadyAcquired}} is-acquired{{/if}}">
            {{localize "DHLANG.Dialog.cost"}}:
            {{#if this.hasDiscount}}
              <del>{{this.originalCost}}</del> → {{this.effectiveCost}}
            {{else}}
              {{this.effectiveCost}}
            {{/if}}
          </span>
        {{/unless}}
        {{#if this.alreadyAcquired}}
          {{#unless ../../isAdversary}}
          <span class="lang-acquired-tag">✓</span>
          {{/unless}}
        {{else}}
          <button
            type="button"
            data-action="acquireLanguage"
            data-language-id="{{this.id}}"
            {{#unless this.canAcquire}}disabled{{/unless}}
            {{#if this.requirementTooltip}}data-tooltip="{{this.requirementTooltip}}"{{/if}}
          >{{localize "DHLANG.Dialog.acquire"}}</button>
        {{/if}}
      </div>
    </div>
    {{/each}}
  </details>
  {{else}}
  <p class="no-languages-hint">{{localize "DHLANG.Dialog.noLanguagesConfigured"}}</p>
  {{/each}}

</div>
