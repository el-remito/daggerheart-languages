<div class="dh-settings-config">

  {{!-- Point pool formula --}}
  <div class="config-section formula-section">
    <label for="point-formula">{{localize "DHLANG.Settings.pointFormula"}}</label>
    <input id="point-formula" type="text" value="{{config.pointFormula}}" placeholder="2" />
    <p class="hint">{{pointFormulaHint}}</p>
  </div>

  {{!-- Point Pool Rules --}}
  <div class="config-section point-rules-section">
    <h3 class="point-rules-heading">{{localize "DHLANG.Settings.pointRules"}}</h3>
    <p class="hint">{{localize "DHLANG.Settings.pointRulesHint"}}</p>
    {{#each config.pointRules}}
    <div class="point-rule-row">
      <div class="requirement-group">
        <span class="rg-label">{{localize "DHLANG.Settings.pointRuleCondition"}}</span>
        <div class="rg-row">
          <input type="text" value="{{this.condition}}" data-field="pointRuleCondition"
                 data-rule-id="{{this.id}}" placeholder="e.g. communityIs:Highborne" />
          <button type="button" class="picker-toggle-btn">⚡ {{localize "DHLANG.Picker.toggle"}}</button>
        </div>
        <div class="formula-picker" hidden>
          <select class="picker-type-select">
            <option value="custom">{{localize "DHLANG.Picker.typeCustom"}}</option>
            <option value="hasFeature">{{localize "DHLANG.Picker.typeHasFeature"}}</option>
            <option value="hasDomain">{{localize "DHLANG.Picker.typeHasDomain"}}</option>
            <option value="hasSpellcasting">{{localize "DHLANG.Picker.typeHasSpellcasting"}}</option>
            <option value="traitAtLeast">{{localize "DHLANG.Picker.typeTraitAtLeast"}}</option>
            <option value="tierAtLeast">{{localize "DHLANG.Picker.typeTierAtLeast"}}</option>
            <option value="levelAtLeast">{{localize "DHLANG.Picker.typeLevelAtLeast"}}</option>
            <option value="classIs">{{localize "DHLANG.Picker.typeClassIs"}}</option>
            <option value="communityIs">{{localize "DHLANG.Picker.typeCommunityIs"}}</option>
            <option value="ancestryIs">{{localize "DHLANG.Picker.typeAncestryIs"}}</option>
          </select>
          <div class="picker-sub picker-sub--feature" hidden>
            <label>{{localize "DHLANG.Picker.featureName"}}
              <input type="text" class="picker-feature-name" placeholder="e.g. Wildtouch" />
            </label>
          </div>
          <div class="picker-sub picker-sub--domain" hidden>
            <label>{{localize "DHLANG.Picker.domainName"}}
              <input type="text" class="picker-domain-name" placeholder="e.g. Splendor" />
            </label>
          </div>
          <div class="picker-sub picker-sub--trait" hidden>
            <select class="picker-trait-select">
              <option value="agility">{{localize "DHLANG.Picker.traitAgility"}}</option>
              <option value="strength">{{localize "DHLANG.Picker.traitStrength"}}</option>
              <option value="finesse">{{localize "DHLANG.Picker.traitFinesse"}}</option>
              <option value="instinct">{{localize "DHLANG.Picker.traitInstinct"}}</option>
              <option value="presence">{{localize "DHLANG.Picker.traitPresence"}}</option>
              <option value="knowledge">{{localize "DHLANG.Picker.traitKnowledge"}}</option>
            </select>
            <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
              <input type="number" class="picker-min-value" value="1" min="1" />
            </label>
          </div>
          <div class="picker-sub picker-sub--tier-at-least" hidden>
            <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
              <input type="number" class="picker-tier-min" value="1" min="1" />
            </label>
          </div>
          <div class="picker-sub picker-sub--level-at-least" hidden>
            <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
              <input type="number" class="picker-level-min" value="1" min="1" />
            </label>
          </div>
          <div class="picker-sub picker-sub--class" hidden>
            <label>{{localize "DHLANG.Picker.className"}}
              <input type="text" class="picker-class-name" placeholder="e.g. Warrior" />
            </label>
          </div>
          <div class="picker-sub picker-sub--community" hidden>
            <label>{{localize "DHLANG.Picker.communityName"}}
              <input type="text" class="picker-community-name" placeholder="e.g. Wanderborne" />
            </label>
          </div>
          <div class="picker-sub picker-sub--ancestry" hidden>
            <label>{{localize "DHLANG.Picker.ancestryName"}}
              <input type="text" class="picker-ancestry-name" placeholder="e.g. Elf" />
            </label>
          </div>
          <div class="picker-actions">
            <button type="button" class="picker-set-btn">{{localize "DHLANG.Picker.set"}}</button>
            <button type="button" class="picker-and-btn">{{localize "DHLANG.Picker.andOperator"}}</button>
            <button type="button" class="picker-or-btn">{{localize "DHLANG.Picker.orOperator"}}</button>
          </div>
        </div>
      </div>
      <label class="point-rule-modifier">
        {{localize "DHLANG.Settings.pointRuleModifier"}}
        <input type="text" value="{{this.modifier}}" data-field="pointRuleModifier"
               data-rule-id="{{this.id}}" placeholder="e.g. 7 or @tier" />
      </label>
      <label class="point-rule-label-field">
        {{localize "DHLANG.Settings.pointRuleLabel"}}
        <input type="text" value="{{this.label}}" data-field="pointRuleLabel"
               data-rule-id="{{this.id}}"
               placeholder="{{localize 'DHLANG.Settings.pointRuleLabelPlaceholder'}}" />
      </label>
      <button type="button" data-action="removePointRule" data-rule-id="{{this.id}}"
              class="remove-btn danger">✕</button>
    </div>
    {{/each}}
    <button type="button" data-action="addPointRule" class="add-btn">
      + {{localize "DHLANG.Settings.addPointRule"}}
    </button>
  </div>

  {{!-- Search bar --}}
  <div class="config-section dh-lang-search-bar">
    <input type="search" class="dh-lang-search" placeholder="{{localize 'DHLANG.Search.placeholder'}}" />
  </div>

  {{!-- Categories --}}
  <div class="config-section categories-section">
    {{#each config.categories}}
    <details class="config-category">
      <summary class="category-header">
        <span class="dh-collapse-arrow">▶</span>
        <input
          type="text"
          value="{{this.name}}"
          data-field="categoryName"
          data-category-id="{{this.id}}"
          placeholder="{{localize 'DHLANG.Settings.categoryName'}}"
        />
        <span class="category-lang-count">({{this.languages.length}})</span>
        <button type="button" data-action="removeCategory" data-category-id="{{this.id}}" class="remove-btn danger">✕</button>
      </summary>

      <div class="category-defaults">
        <label>
          {{localize "DHLANG.Settings.defaultCost"}}
          <input type="text" value="{{this.cost}}" data-field="categoryCost" data-category-id="{{this.id}}" />
        </label>
        <div class="requirement-group">
          <span class="rg-label">{{localize "DHLANG.Settings.defaultRequirement"}}</span>
          <div class="rg-row">
            <input type="text" value="{{this.requirement}}" data-field="categoryRequirement" data-category-id="{{this.id}}" placeholder="optional" />
            <button type="button" class="picker-toggle-btn">⚡ {{localize "DHLANG.Picker.toggle"}}</button>
          </div>
          <div class="formula-picker" hidden>
            <select class="picker-type-select">
              <option value="custom">{{localize "DHLANG.Picker.typeCustom"}}</option>
              <option value="hasFeature">{{localize "DHLANG.Picker.typeHasFeature"}}</option>
              <option value="hasDomain">{{localize "DHLANG.Picker.typeHasDomain"}}</option>
              <option value="hasSpellcasting">{{localize "DHLANG.Picker.typeHasSpellcasting"}}</option>
              <option value="traitAtLeast">{{localize "DHLANG.Picker.typeTraitAtLeast"}}</option>
              <option value="tierAtLeast">{{localize "DHLANG.Picker.typeTierAtLeast"}}</option>
              <option value="levelAtLeast">{{localize "DHLANG.Picker.typeLevelAtLeast"}}</option>
              <option value="classIs">{{localize "DHLANG.Picker.typeClassIs"}}</option>
              <option value="communityIs">{{localize "DHLANG.Picker.typeCommunityIs"}}</option>
              <option value="ancestryIs">{{localize "DHLANG.Picker.typeAncestryIs"}}</option>
            </select>
            <div class="picker-sub picker-sub--feature" hidden>
              <label>{{localize "DHLANG.Picker.featureName"}}
                <input type="text" class="picker-feature-name" placeholder="e.g. Wildtouch" />
              </label>
            </div>
            <div class="picker-sub picker-sub--domain" hidden>
              <label>{{localize "DHLANG.Picker.domainName"}}
                <input type="text" class="picker-domain-name" placeholder="e.g. Splendor" />
              </label>
            </div>
            <div class="picker-sub picker-sub--trait" hidden>
              <select class="picker-trait-select">
                <option value="agility">{{localize "DHLANG.Picker.traitAgility"}}</option>
                <option value="strength">{{localize "DHLANG.Picker.traitStrength"}}</option>
                <option value="finesse">{{localize "DHLANG.Picker.traitFinesse"}}</option>
                <option value="instinct">{{localize "DHLANG.Picker.traitInstinct"}}</option>
                <option value="presence">{{localize "DHLANG.Picker.traitPresence"}}</option>
                <option value="knowledge">{{localize "DHLANG.Picker.traitKnowledge"}}</option>
              </select>
              <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                <input type="number" class="picker-min-value" value="1" min="1" />
              </label>
            </div>
            <div class="picker-sub picker-sub--community" hidden>
              <label>{{localize "DHLANG.Picker.communityName"}}
                <input type="text" class="picker-community-name" placeholder="e.g. Wanderborne" />
              </label>
            </div>
            <div class="picker-sub picker-sub--ancestry" hidden>
              <label>{{localize "DHLANG.Picker.ancestryName"}}
                <input type="text" class="picker-ancestry-name" placeholder="e.g. Elf" />
              </label>
            </div>
            <div class="picker-actions">
              <button type="button" class="picker-set-btn">{{localize "DHLANG.Picker.set"}}</button>
              <button type="button" class="picker-and-btn">{{localize "DHLANG.Picker.andOperator"}}</button>
              <button type="button" class="picker-or-btn">{{localize "DHLANG.Picker.orOperator"}}</button>
            </div>
          </div>
        </div>
        <label>
          {{localize "DHLANG.Settings.categoryDescription"}}
          <textarea data-field="categoryDescription" data-category-id="{{this.id}}" placeholder="optional" rows="2">{{this.description}}</textarea>
        </label>
      </div>

      {{!-- Languages --}}
      {{#each this.languages}}
      <details class="config-language">
        <summary class="language-header">
          <span class="dh-collapse-arrow">▶</span>
          <input
            type="text"
            value="{{this.name}}"
            data-field="languageName"
            data-category-id="{{../id}}"
            data-language-id="{{this.id}}"
            placeholder="{{localize 'DHLANG.Settings.languageName'}}"
          />
          <button type="button" data-action="removeLanguage" data-category-id="{{../id}}" data-language-id="{{this.id}}" class="remove-btn danger">✕</button>
        </summary>

        <div class="language-fields">
          <label>
            {{localize "DHLANG.Settings.costOverride"}}
            <input type="text" value="{{this.cost}}" data-field="languageCost" data-category-id="{{../id}}" data-language-id="{{this.id}}" placeholder="optional" />
          </label>
          <div class="requirement-group">
            <span class="rg-label">{{localize "DHLANG.Settings.requirementOverride"}}</span>
            <div class="rg-row">
              <input type="text" value="{{this.requirement}}" data-field="languageRequirement" data-category-id="{{../id}}" data-language-id="{{this.id}}" placeholder="optional" />
              <button type="button" class="picker-toggle-btn">⚡ {{localize "DHLANG.Picker.toggle"}}</button>
            </div>
            <div class="formula-picker" hidden>
              <select class="picker-type-select">
                <option value="custom">{{localize "DHLANG.Picker.typeCustom"}}</option>
                <option value="hasFeature">{{localize "DHLANG.Picker.typeHasFeature"}}</option>
                <option value="hasDomain">{{localize "DHLANG.Picker.typeHasDomain"}}</option>
                <option value="hasSpellcasting">{{localize "DHLANG.Picker.typeHasSpellcasting"}}</option>
                <option value="traitAtLeast">{{localize "DHLANG.Picker.typeTraitAtLeast"}}</option>
                <option value="tierAtLeast">{{localize "DHLANG.Picker.typeTierAtLeast"}}</option>
                <option value="levelAtLeast">{{localize "DHLANG.Picker.typeLevelAtLeast"}}</option>
                <option value="classIs">{{localize "DHLANG.Picker.typeClassIs"}}</option>
              <option value="communityIs">{{localize "DHLANG.Picker.typeCommunityIs"}}</option>
              <option value="ancestryIs">{{localize "DHLANG.Picker.typeAncestryIs"}}</option>
              </select>
              <div class="picker-sub picker-sub--feature" hidden>
                <label>{{localize "DHLANG.Picker.featureName"}}
                  <input type="text" class="picker-feature-name" placeholder="e.g. Wildtouch" />
                </label>
              </div>
              <div class="picker-sub picker-sub--domain" hidden>
                <label>{{localize "DHLANG.Picker.domainName"}}
                  <input type="text" class="picker-domain-name" placeholder="e.g. Splendor" />
                </label>
              </div>
              <div class="picker-sub picker-sub--trait" hidden>
                <select class="picker-trait-select">
                  <option value="agility">{{localize "DHLANG.Picker.traitAgility"}}</option>
                  <option value="strength">{{localize "DHLANG.Picker.traitStrength"}}</option>
                  <option value="finesse">{{localize "DHLANG.Picker.traitFinesse"}}</option>
                  <option value="instinct">{{localize "DHLANG.Picker.traitInstinct"}}</option>
                  <option value="presence">{{localize "DHLANG.Picker.traitPresence"}}</option>
                  <option value="knowledge">{{localize "DHLANG.Picker.traitKnowledge"}}</option>
                </select>
                <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                  <input type="number" class="picker-min-value" value="1" min="1" />
                </label>
              </div>
              <div class="picker-sub picker-sub--tier-at-least" hidden>
                <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                  <input type="number" class="picker-tier-min" value="1" min="1" />
                </label>
              </div>
              <div class="picker-sub picker-sub--level-at-least" hidden>
                <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                  <input type="number" class="picker-level-min" value="1" min="1" />
                </label>
              </div>
              <div class="picker-sub picker-sub--class" hidden>
                <label>{{localize "DHLANG.Picker.className"}}
                  <input type="text" class="picker-class-name" placeholder="e.g. Warrior" />
                </label>
              </div>
              <div class="picker-sub picker-sub--community" hidden>
                <label>{{localize "DHLANG.Picker.communityName"}}
                  <input type="text" class="picker-community-name" placeholder="e.g. Wanderborne" />
                </label>
              </div>
              <div class="picker-sub picker-sub--ancestry" hidden>
                <label>{{localize "DHLANG.Picker.ancestryName"}}
                  <input type="text" class="picker-ancestry-name" placeholder="e.g. Elf" />
                </label>
              </div>
              <div class="picker-actions">
              <button type="button" class="picker-set-btn">{{localize "DHLANG.Picker.set"}}</button>
              <button type="button" class="picker-and-btn">{{localize "DHLANG.Picker.andOperator"}}</button>
              <button type="button" class="picker-or-btn">{{localize "DHLANG.Picker.orOperator"}}</button>
            </div>
            </div>
          </div>
          <label>
            {{localize "DHLANG.Settings.languageDescription"}}
            <textarea data-field="languageDescription" data-category-id="{{../id}}" data-language-id="{{this.id}}" placeholder="optional" rows="2">{{this.description}}</textarea>
          </label>
          <label class="language-universal-label">
            <input type="checkbox" data-field="languageUniversal" data-category-id="{{../id}}" data-language-id="{{this.id}}" {{#if this.universal}}checked{{/if}} />
            {{localize "DHLANG.Settings.languageUniversal"}}
          </label>
        </div>

        {{!-- Cost Rules --}}
        <div class="cost-rules-section">
          <h4>{{localize "DHLANG.Settings.costRules"}}</h4>
          {{#each this.costRules}}
          <div class="cost-rule-row">
            <div class="requirement-group">
              <span class="rg-label">{{localize "DHLANG.Settings.costRuleRequirement"}}</span>
              <div class="rg-row">
                <input type="text" value="{{this.requirement}}" data-field="costRuleRequirement" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-rule-index="{{@index}}" placeholder="optional" />
                <button type="button" class="picker-toggle-btn">⚡ {{localize "DHLANG.Picker.toggle"}}</button>
              </div>
              <div class="formula-picker" hidden>
                <select class="picker-type-select">
                  <option value="custom">{{localize "DHLANG.Picker.typeCustom"}}</option>
                  <option value="hasFeature">{{localize "DHLANG.Picker.typeHasFeature"}}</option>
                  <option value="hasDomain">{{localize "DHLANG.Picker.typeHasDomain"}}</option>
                  <option value="hasSpellcasting">{{localize "DHLANG.Picker.typeHasSpellcasting"}}</option>
                  <option value="traitAtLeast">{{localize "DHLANG.Picker.typeTraitAtLeast"}}</option>
                  <option value="tierAtLeast">{{localize "DHLANG.Picker.typeTierAtLeast"}}</option>
                  <option value="levelAtLeast">{{localize "DHLANG.Picker.typeLevelAtLeast"}}</option>
                  <option value="classIs">{{localize "DHLANG.Picker.typeClassIs"}}</option>
                  <option value="communityIs">{{localize "DHLANG.Picker.typeCommunityIs"}}</option>
                  <option value="ancestryIs">{{localize "DHLANG.Picker.typeAncestryIs"}}</option>
                </select>
                <div class="picker-sub picker-sub--feature" hidden>
                  <label>{{localize "DHLANG.Picker.featureName"}}
                    <input type="text" class="picker-feature-name" placeholder="e.g. Wildtouch" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--domain" hidden>
                  <label>{{localize "DHLANG.Picker.domainName"}}
                    <input type="text" class="picker-domain-name" placeholder="e.g. Splendor" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--trait" hidden>
                  <select class="picker-trait-select">
                    <option value="agility">{{localize "DHLANG.Picker.traitAgility"}}</option>
                    <option value="strength">{{localize "DHLANG.Picker.traitStrength"}}</option>
                    <option value="finesse">{{localize "DHLANG.Picker.traitFinesse"}}</option>
                    <option value="instinct">{{localize "DHLANG.Picker.traitInstinct"}}</option>
                    <option value="presence">{{localize "DHLANG.Picker.traitPresence"}}</option>
                    <option value="knowledge">{{localize "DHLANG.Picker.traitKnowledge"}}</option>
                  </select>
                  <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                    <input type="number" class="picker-min-value" value="1" min="1" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--tier-at-least" hidden>
                  <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                    <input type="number" class="picker-tier-min" value="1" min="1" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--level-at-least" hidden>
                  <label class="picker-min-label">{{localize "DHLANG.Picker.minValue"}}
                    <input type="number" class="picker-level-min" value="1" min="1" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--class" hidden>
                  <label>{{localize "DHLANG.Picker.className"}}
                    <input type="text" class="picker-class-name" placeholder="e.g. Warrior" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--community" hidden>
                  <label>{{localize "DHLANG.Picker.communityName"}}
                    <input type="text" class="picker-community-name" placeholder="e.g. Wanderborne" />
                  </label>
                </div>
                <div class="picker-sub picker-sub--ancestry" hidden>
                  <label>{{localize "DHLANG.Picker.ancestryName"}}
                    <input type="text" class="picker-ancestry-name" placeholder="e.g. Elf" />
                  </label>
                </div>
                <div class="picker-actions">
                  <button type="button" class="picker-set-btn">{{localize "DHLANG.Picker.set"}}</button>
                  <button type="button" class="picker-and-btn">{{localize "DHLANG.Picker.andOperator"}}</button>
                  <button type="button" class="picker-or-btn">{{localize "DHLANG.Picker.orOperator"}}</button>
                </div>
              </div>
            </div>
            <label class="cost-rule-cost">
              {{localize "DHLANG.Settings.costRuleDiscountAmount"}}
              <input type="text" value="{{this.discountAmount}}" data-field="costRuleDiscountAmount" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-rule-index="{{@index}}" />
            </label>
            <button type="button" data-action="removeCostRule" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-rule-index="{{@index}}" class="remove-btn danger">✕</button>
          </div>
          {{/each}}
          <button type="button" data-action="addCostRule" data-category-id="{{../id}}" data-language-id="{{this.id}}" class="add-btn">
            + {{localize "DHLANG.Settings.addCostRule"}}
          </button>
        </div>

        {{!-- Cousins --}}
        <div class="cousin-section">
          <h4>{{localize "DHLANG.Settings.cousins"}}</h4>
          {{#each this.cousins}}
          <div class="cousin-row">
            <select data-field="cousinLanguageId" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-cousin-index="{{@index}}">
              <option value="">— {{localize "DHLANG.Settings.cousinLanguage"}} —</option>
              {{#each this._options}}
              <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
            <label class="cousin-cost">
              {{localize "DHLANG.Settings.cousinDiscountAmount"}}
              <input type="text" value="{{this.discountAmount}}" data-field="cousinDiscountAmount" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-cousin-index="{{@index}}" />
            </label>
            <label class="cousin-waive">
              <input type="checkbox" {{#if this.waiveRequirement}}checked{{/if}} data-field="cousinWaiveRequirement" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-cousin-index="{{@index}}" />
              {{localize "DHLANG.Settings.cousinWaiveRequirement"}}
            </label>
            <button type="button" data-action="removeCousin" data-category-id="{{../../id}}" data-language-id="{{../id}}" data-cousin-index="{{@index}}" class="remove-btn danger">✕</button>
          </div>
          {{/each}}
          <button type="button" data-action="addCousin" data-category-id="{{../id}}" data-language-id="{{this.id}}" class="add-btn">
            + {{localize "DHLANG.Settings.addCousin"}}
          </button>
        </div>

      </details>
      {{/each}}

      <button type="button" data-action="addLanguage" data-category-id="{{this.id}}" class="add-btn">
        + {{localize "DHLANG.Settings.addLanguage"}}
      </button>
    </details>
    {{/each}}

    <button type="button" data-action="addCategory" class="add-btn category-add-btn">
      + {{localize "DHLANG.Settings.addCategory"}}
    </button>
  </div>

  {{!-- Footer --}}
  <div class="config-footer">
    <button type="button" data-action="saveConfig" class="save-btn">{{localize "DHLANG.Settings.save"}}</button>
    <button type="button" data-action="cancelConfig" class="cancel-btn">{{localize "DHLANG.Settings.cancel"}}</button>
  </div>

</div>
